# LLM provider selection (added in a later slice; stub is used when unset)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# Number of chunks to retrieve per query (default: 8)
# TOP_K=8

# Similarity gate threshold (layer 1 of grounding).  Queries whose best body-only
# cosine falls below this value are refused without calling the LLM.  Sits in the
# measured gap between on-topic (0.51–0.85) and off-topic (0.01–0.18) body-only cosines.
# Pending formal calibration against the 8-row eval set (D10).
# SIMILARITY_THRESHOLD=0.35

# Enable dual embedding: retrieve on header+body vector, gate and score on body-only
# vector.  Set to false to activate the single-vector baseline for comparison (D6).
# DUAL_EMBEDDING=true
