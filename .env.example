# LLM provider selection: 'ollama' (local, default) or 'groq' (hosted).
# Exactly one provider is active per process — no auto-detection or fallback.
# LLM_PROVIDER=ollama

# Model identifier.  Default depends on provider:
#   ollama: qwen2.5:3b  (chosen by measurement; see issue #11 for comparison table)
#   groq:   llama-3.1-8b-instant
# LLM_MODEL=qwen2.5:3b

# ── Ollama (local) ────────────────────────────────────────────────────────────
# Base URL of the Ollama daemon.
# OLLAMA_HOST=http://localhost:11434

# How long the daemon keeps the model loaded after the last request.
# Pass '0' on a memory-starved machine to unload between requests (trades RAM for latency).
# OLLAMA_KEEP_ALIVE=5m

# Context window and max output tokens sent per call.  Defaults are the measured
# right-sizing for an 8 GB machine (prompt ~700 tokens + 300 output; a larger
# context only wastes KV cache) — override only if you know why.
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_PREDICT=300

# seed=42 is fixed (not configurable) — combined with temperature=0 for
# byte-identical determinism across runs.

# Daemon-level tuning (set BEFORE running 'ollama serve', not in this file):
#   OLLAMA_NUM_PARALLEL=1       — one KV-cache slot; prevents silent 4× RAM use
#   OLLAMA_MAX_LOADED_MODELS=1  — one model resident at a time
# See README.md "Running the server" for the full startup command.

# ── Groq (hosted) ────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=groq; unused (and not needed) for ollama.
# GROQ_API_KEY=your-key-here

# ── Retrieval ────────────────────────────────────────────────────────────────
# Number of chunks to retrieve per query (default: 8)
# TOP_K=8

# Similarity gate threshold (layer 1 of grounding).  Queries whose best body-only
# cosine falls below this value are refused without calling the LLM.  Calibrated to
# avoid false-refusing answerable questions (which score 0.34–0.77 in no_dual mode,
# eval set D10).  NOTE: absent-topic / wrong-product refusals do NOT rely on this
# gate — measured off-topic queries score 0.527–0.558, above the threshold.  Those
# refusals come from layers 3–4 (prompt constraint + cite-or-refuse id validation).
# SIMILARITY_THRESHOLD=0.35

# Dual embedding: retrieve on header+body vector, gate and score on body-only vector.
# Kill criterion (D6) was triggered: the single-vector baseline (DUAL_EMBEDDING=false)
# outperforms dual embedding on every eval metric (correct section 7/7 vs 2/7, no
# false refusals vs 1).  Default is now OFF.  Set to true only to reproduce the
# ablation study documented in eval_results.md.
# DUAL_EMBEDDING=false
